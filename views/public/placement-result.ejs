<div class="max-w-2xl mx-auto text-center">
  <h1 class="text-3xl font-extrabold text-navy dark:text-white">Your Placement Result</h1>
  <div class="gold-underline w-16 mx-auto mt-2 mb-6"></div>

  <div class="bg-navy text-white rounded-2xl p-8 shadow">
    <p class="text-sm text-gray-300">Estimated level</p>
    <p class="text-6xl font-extrabold text-gold mt-2"><%= cefr %></p>
    <p class="mt-3 text-gray-200"><%= description %></p>
    <p class="mt-4 text-sm text-gray-300">Score: <strong class="text-white"><%= result.score %> / <%= result.max_score %></strong></p>
  </div>

  <div class="mt-6 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded-xl p-4 text-sm text-amber-900 dark:text-amber-100" role="note">
    <strong>Please note:</strong> this is an <em>estimate</em> for course placement, not an official
    CEFR certification or accredited qualification. Your teacher will review your result and may
    adjust your assigned level.
  </div>

  <% if (recommended) { %>
    <div class="mt-6 bg-white dark:bg-gray-800 rounded-xl p-6 shadow text-left">
      <h2 class="font-bold text-navy dark:text-white">Recommended starting course</h2>
      <p class="mt-1 font-semibold"><%= recommended.title %> <% if (recommended.level) { %><span class="text-xs bg-gold/15 text-gold-600 dark:text-gold px-2 py-0.5 rounded"><%= recommended.level %></span><% } %></p>
      <p class="text-sm text-gray-600 dark:text-gray-300 mt-1"><%= (recommended.description || '').slice(0, 160) %></p>
      <a href="/courses/<%= recommended.slug %>" class="inline-block mt-3 bg-navy text-white px-5 py-2 rounded-lg text-sm hover:bg-navy-800">View course</a>
    </div>
  <% } %>

  <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
    <% if (!user) { %><a href="/register" class="bg-gold text-navy font-bold px-6 py-3 rounded-lg hover:bg-gold-600 hover:text-white">Create Free Account</a><% } %>
    <a href="/courses" class="border border-navy dark:border-gold text-navy dark:text-gold px-6 py-3 rounded-lg font-semibold">Browse Courses</a>
  </div>
</div>

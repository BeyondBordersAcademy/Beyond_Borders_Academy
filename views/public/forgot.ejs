<div class="max-w-md mx-auto">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow p-8">
    <h1 class="text-2xl font-extrabold text-navy dark:text-white">Reset Password</h1>
    <p class="text-sm text-gray-500 mt-1 mb-6">Enter your account email and we'll send you a reset link (valid for 1 hour).</p>
    <form method="post" action="/forgot" class="space-y-4">
      <div>
        <label for="email" class="block text-sm font-semibold mb-1">Email</label>
        <input id="email" name="email" type="email" required class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
      </div>
      <button class="w-full bg-navy text-white font-semibold py-3 rounded-lg hover:bg-navy-800">Send Reset Link</button>
    </form>
  </div>
</div>

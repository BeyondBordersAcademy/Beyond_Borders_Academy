<div class="max-w-md mx-auto">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow p-8">
    <div class="flex justify-center mb-4"><%- include('../partials/logo', { size: 56 }) %></div>
    <h1 class="text-2xl font-extrabold text-navy dark:text-white text-center"><%= invite ? 'Accept Your Invitation' : 'Create Your Account' %></h1>
    <p class="text-sm text-gray-500 text-center mt-1 mb-6">
      <%= invite ? 'You were invited as: ' + invite.email : 'Free student account at ' + siteName %>
    </p>
    <form method="post" action="/register" class="space-y-4">
      <% if (invite) { %><input type="hidden" name="invite_token" value="<%= invite.token %>"><% } %>
      <div>
        <label for="name" class="block text-sm font-semibold mb-1">Full name</label>
        <input id="name" name="name" required maxlength="120" autocomplete="name" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
      </div>
      <div>
        <label for="email" class="block text-sm font-semibold mb-1">Email</label>
        <input id="email" name="email" type="email" required maxlength="160" autocomplete="email" value="<%= invite ? invite.email : '' %>" <%= invite ? 'readonly' : '' %> class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
      </div>
      <div>
        <label for="password" class="block text-sm font-semibold mb-1">Password <span class="font-normal text-gray-500">(min. 8 characters)</span></label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
      </div>
      <button class="w-full bg-gold text-navy font-bold py-3 rounded-lg hover:bg-gold-600 hover:text-white"><%= invite ? 'Accept Invitation' : 'Create Account' %></button>
    </form>
    <p class="mt-4 text-xs text-gray-500 text-center">By registering you agree to our <a href="/policies/terms" class="underline">terms of use</a> and <a href="/policies/privacy" class="underline">privacy policy</a>.</p>
  </div>
</div>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-extrabold text-navy dark:text-white">English Placement Assessment</h1>
  <div class="gold-underline w-16 mt-2 mb-4"></div>
  <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
    Answer all <%= questions.length %> questions. This test covers grammar, vocabulary, reading,
    listening, and practical communication. Your result is an <strong>approximate CEFR level
    (A1–C2)</strong> used to recommend a starting course — it is <strong>not</strong> an official
    certification. Your teacher may review and adjust your level.
  </p>

  <form method="post" action="/placement" class="mt-6 space-y-6">
    <div class="grid sm:grid-cols-2 gap-4 bg-white dark:bg-gray-800 rounded-xl p-5 shadow">
      <div>
        <label for="pname" class="block text-sm font-semibold mb-1">Your name</label>
        <input id="pname" name="name" value="<%= user ? user.name : '' %>" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
      </div>
      <div>
        <label for="pemail" class="block text-sm font-semibold mb-1">Email (to save your result)</label>
        <input id="pemail" name="email" type="email" value="<%= user ? user.email : '' %>" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
      </div>
    </div>

    <% questions.forEach((q, i) => { %>
      <fieldset class="bg-white dark:bg-gray-800 rounded-xl p-5 shadow">
        <legend class="font-semibold text-navy dark:text-white px-1">
          <span class="text-xs font-bold text-gold-600 dark:text-gold mr-2"><%= q.section %> · <%= q.level %></span>
          <%= i + 1 %>. <%= q.prompt %>
        </legend>
        <div class="mt-3 space-y-2">
          <% q.options.forEach(opt => { %>
            <label class="flex items-center gap-3 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700">
              <input type="radio" name="answers[<%= i %>]" value="<%= opt %>" required class="accent-[#C6A34B]">
              <span class="text-sm"><%= opt %></span>
            </label>
          <% }) %>
        </div>
      </fieldset>
    <% }) %>

    <button class="w-full bg-gold text-navy font-bold px-6 py-4 rounded-xl text-lg hover:bg-gold-600 hover:text-white">See My Result</button>
  </form>
</div>

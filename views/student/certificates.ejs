<h1 class="text-3xl font-extrabold text-navy dark:text-white">My Certificates</h1>
<div class="gold-underline w-16 mt-2 mb-6"></div>
<% if (!certs.length) { %>
  <div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow text-center">
    <p class="text-4xl mb-3">🎓</p>
    <p class="text-gray-600 dark:text-gray-400">No certificates yet. Complete a course to earn your first certificate.</p>
  </div>
<% } %>
<div class="grid gap-5 sm:grid-cols-2">
  <% certs.forEach(c => { %>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow overflow-hidden border border-gray-100 dark:border-gray-700">
      <div class="bg-navy text-white px-5 py-4">
        <p class="font-bold"><%= c.course_title %></p>
        <p class="text-xs text-gray-300"><%= c.course_level ? 'Level ' + c.course_level + ' · ' : '' %>Issued <%= fmtDate(c.issued_at) %></p>
      </div>
      <div class="p-5 flex items-center justify-between">
        <span class="font-mono text-sm font-bold <%= c.status === 'valid' ? 'text-green-700 dark:text-green-300' : 'text-red-600' %>"><%= c.code %> · <%= c.status %></span>
        <% if (c.status === 'valid') { %>
          <a href="/certificates/<%= c.id %>/download" class="text-sm bg-gold text-navy font-bold px-4 py-2 rounded hover:bg-gold-600 hover:text-white">Download PDF</a>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>
<p class="mt-6 text-xs text-gray-500">Academy certificates of completion — not government-accredited qualifications or official CEFR certifications. Anyone can verify a certificate at <a href="/verify/0000" class="underline">the verification page</a>.</p>

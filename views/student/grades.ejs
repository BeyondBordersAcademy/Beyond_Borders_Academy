<h1 class="text-3xl font-extrabold text-navy dark:text-white">My Grades</h1>
<div class="gold-underline w-16 mt-2 mb-6"></div>
<% if (!books.length) { %><p class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow text-gray-500">You're not enrolled in any courses yet.</p><% } %>
<% books.forEach(({ enrollment, book }) => { %>
  <section class="bg-white dark:bg-gray-800 rounded-2xl shadow p-6 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-bold text-navy dark:text-white"><%= enrollment.title %></h2>
      <span class="text-lg font-extrabold <%= book.overall == null ? 'text-gray-400' : book.overall >= 70 ? 'text-green-700 dark:text-green-300' : 'text-amber-700 dark:text-amber-300' %>">
        <%= book.overall == null ? 'No grades yet' : book.overall + '%' %>
      </span>
    </div>
    <p class="text-xs text-gray-500 mt-1"><%= book.gradedCount %> graded · <%= book.missingCount %> missing/not submitted</p>
    <div class="overflow-x-auto mt-4">
      <table class="w-full text-sm">
        <thead><tr class="text-left text-gray-500 border-b border-gray-200 dark:border-gray-700">
          <th class="py-2 pr-4">Item</th><th class="py-2 pr-4">Category</th><th class="py-2 pr-4">Status</th><th class="py-2 text-right">Score</th>
        </tr></thead>
        <tbody>
          <% book.items.forEach(it => { %>
            <tr class="border-b border-gray-100 dark:border-gray-700">
              <td class="py-2 pr-4"><%= it.title %></td>
              <td class="py-2 pr-4 text-gray-500"><%= it.category %></td>
              <td class="py-2 pr-4 text-xs"><%= (it.status || '').replace(/_/g, ' ') %></td>
              <td class="py-2 text-right font-semibold"><%= it.earned == null ? '—' : it.earned + ' / ' + it.max %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (Object.keys(book.categories).length > 1) { %>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <% Object.entries(book.categories).forEach(([c, g]) => { %>
          <span class="bg-gray-100 dark:bg-gray-700 rounded px-2 py-1"><%= c %>: <strong><%= g.pct == null ? '—' : Math.round(g.pct) + '%' %></strong><%= g.weight ? ` (weight ${g.weight}%)` : '' %></span>
        <% }) %>
      </div>
    <% } %>
  </section>
<% }) %>

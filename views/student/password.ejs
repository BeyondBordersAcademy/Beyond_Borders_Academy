<div class="max-w-md mx-auto">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow p-8">
    <h1 class="text-2xl font-extrabold text-navy dark:text-white">Change Password</h1>
    <% if (forced) { %><p class="text-sm bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded p-3 mt-3">For security, please set a new password to continue.</p><% } %>
    <form method="post" action="/profile/password" class="space-y-4 mt-6">
      <% if (!forced) { %>
        <div>
          <label for="cur" class="block text-sm font-semibold mb-1">Current password</label>
          <input id="cur" name="current_password" type="password" autocomplete="current-password" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
        </div>
      <% } %>
      <div>
        <label for="new" class="block text-sm font-semibold mb-1">New password <span class="font-normal text-gray-500">(min. 8 characters)</span></label>
        <input id="new" name="new_password" type="password" required minlength="8" autocomplete="new-password" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
      </div>
      <button class="w-full bg-navy text-white font-semibold py-3 rounded-lg hover:bg-navy-800">Update Password</button>
    </form>
  </div>
</div>

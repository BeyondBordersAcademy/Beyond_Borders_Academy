<%- include('_nav', { active: '/admin/assignments' }) %>
<nav class="text-xs text-gray-500 mb-4"><a href="/admin/assignments" class="underline">Assignments</a> › Grade</nav>
<h1 class="text-2xl font-extrabold text-navy dark:text-white">Grading: <%= a.title %></h1>
<p class="text-sm text-gray-500 mb-6"><%= a.course_title %> · <%= a.max_points %> points</p>

<% if (!subs.length) { %><p class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow text-gray-500 text-sm">No submissions yet.</p><% } %>
<div class="space-y-4">
  <% subs.forEach(s => { %>
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow p-5">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div>
          <p class="font-bold"><%= s.student_name %> <span class="font-normal text-xs text-gray-500"><%= s.email %></span></p>
          <p class="text-xs text-gray-500">Status: <strong><%= s.status.replace(/_/g, ' ') %></strong> · Submitted: <%= s.submitted_at ? fmtDateTime(s.submitted_at) : '—' %></p>
        </div>
      </div>
      <% if (s.body_text) { %>
        <div class="text-sm border border-gray-100 dark:border-gray-700 rounded-lg p-3 whitespace-pre-line max-h-48 overflow-y-auto"><%= s.body_text %></div>
      <% } %>
      <div class="flex flex-wrap gap-3 mt-2 text-xs">
        <% if (s.file_path) { %><a href="/files/<%= s.file_path %>" class="bg-gray-100 dark:bg-gray-700 rounded px-2 py-1 underline">📎 Download: <%= s.file_path.split('/').pop() %></a><% } %>
        <% if (s.audio_path) { %>
          <audio controls src="/files/<%= s.audio_path %>" class="w-full max-w-md mt-1"></audio>
        <% } %>
      </div>
      <form method="post" action="/admin/assignments/<%= a.id %>/grade" class="mt-4 grid sm:grid-cols-[120px_1fr_auto] gap-2 items-start text-sm">
        <input type="hidden" name="submission_id" value="<%= s.id %>">
        <div><label class="block font-semibold mb-1">Grade / <%= a.max_points %></label>
          <input name="grade" type="number" min="0" max="<%= a.max_points %>" step="0.5" value="<%= s.grade != null ? s.grade : '' %>" required class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-2 py-1.5 bg-white dark:bg-gray-900"></div>
        <div><label class="block font-semibold mb-1">Feedback to student</label>
          <textarea name="feedback" rows="2" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-2 py-1.5 bg-white dark:bg-gray-900"><%= s.feedback %></textarea></div>
        <div class="flex gap-2 pt-6">
          <button name="action" value="grade" class="bg-gold text-navy font-bold px-4 py-1.5 rounded">Grade</button>
          <button name="action" value="needs_revision" class="border border-amber-400 text-amber-700 px-4 py-1.5 rounded">Request Revision</button>
        </div>
      </form>
    </div>
  <% }) %>
</div>

<%- include('_nav', { active: '/admin/assignments' }) %>
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-3xl font-extrabold text-navy dark:text-white">Assignments</h1>
  <a href="/admin/assignments/new" class="bg-gold text-navy font-bold px-4 py-2 rounded-lg text-sm">+ New Assignment</a>
</div>
<div class="gold-underline w-16 mt-2 mb-6"></div>
<form method="get" action="/admin/assignments" class="flex gap-2 mb-4 text-sm">
  <select name="course_id" class="border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-800" onchange="this.form.submit()">
    <option value="">All courses</option>
    <% courses.forEach(c => { %><option value="<%= c.id %>" <%= courseId === c.id ? 'selected' : '' %>><%= c.title %></option><% }) %>
  </select>
</form>
<div class="space-y-2">
  <% list.forEach(a => { %>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow px-4 py-3 flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="font-semibold text-sm"><%= a.title %></p>
        <p class="text-xs text-gray-500"><%= a.course_title %> · <%= a.max_points %> pts · Due: <%= a.due_at ? fmtDateTime(a.due_at) : '—' %>
          <% if (a.pending) { %> · <span class="text-amber-700 font-semibold"><%= a.pending %> awaiting grading</span><% } %></p>
      </div>
      <div class="flex gap-2 text-xs">
        <a href="/admin/assignments/<%= a.id %>" class="bg-navy text-white px-3 py-1.5 rounded">Grade</a>
        <form method="post" action="/admin/assignments/<%= a.id %>/delete" onsubmit="return confirm('Delete this assignment? Only possible with no submissions.')">
          <button class="text-red-600 px-2 py-1.5">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
  <% if (!list.length) { %><p class="text-sm text-gray-500">No assignments yet.</p><% } %>
</div>

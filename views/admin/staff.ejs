<%- include('_nav', { active: '/admin/staff' }) %>
<h1 class="text-3xl font-extrabold text-navy dark:text-white">Staff & Course Assignments</h1>
<div class="gold-underline w-16 mt-2 mb-6"></div>
<p class="text-sm text-gray-600 dark:text-gray-300 mb-6 max-w-3xl">Teachers get full control of their <strong>assigned courses</strong> (content, grading, live sessions, attendance). Teaching assistants can grade, mark attendance, and message students in their assigned courses — but cannot edit content or change settings.</p>

<div class="grid lg:grid-cols-3 gap-6">
  <section class="bg-white dark:bg-gray-800 rounded-2xl shadow p-6 h-fit">
    <h2 class="font-bold text-navy dark:text-white mb-3">Add staff member</h2>
    <form method="post" action="/admin/staff" class="space-y-3 text-sm">
      <input type="hidden" name="action" value="create">
      <div><label class="block font-semibold mb-1">Name *</label>
        <input name="name" required maxlength="120" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
      <div><label class="block font-semibold mb-1">Email *</label>
        <input name="email" type="email" required maxlength="160" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
      <div><label class="block font-semibold mb-1">Temporary password *</label>
        <input name="password" type="password" required minlength="8" autocomplete="new-password" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
      <div><label class="block font-semibold mb-1">Role</label>
        <select name="role" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
          <option value="teacher">Teacher</option><option value="ta">Teaching assistant</option>
        </select></div>
      <button class="bg-gold text-navy font-bold px-5 py-2 rounded-lg">Create Account</button>
      <p class="text-xs text-gray-500">They must set a new password on first login.</p>
    </form>
  </section>

  <section class="lg:col-span-2 space-y-4">
    <% staff.forEach(u => { %>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow p-5 text-sm">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div>
            <p class="font-bold text-navy dark:text-white"><%= u.name %>
              <span class="ml-1 text-xs font-bold px-2 py-0.5 rounded <%= u.role === 'admin' ? 'bg-navy text-white' : u.role === 'teacher' ? 'bg-gold/20 text-gold-600 dark:text-gold' : 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-100' %>"><%= u.role %></span>
              <% if (u.status !== 'active') { %><span class="ml-1 text-xs font-bold px-2 py-0.5 rounded bg-red-100 text-red-800"><%= u.status %></span><% } %>
            </p>
            <p class="text-xs text-gray-500"><%= u.email %></p>
          </div>
          <% if (u.role !== 'admin') { %>
            <div class="flex flex-wrap gap-2 text-xs">
              <form method="post" action="/admin/staff" class="inline-flex gap-1">
                <input type="hidden" name="action" value="set_role"><input type="hidden" name="user_id" value="<%= u.id %>">
                <select name="role" class="border rounded-lg px-2 py-1 bg-white dark:bg-gray-900">
                  <option value="teacher" <%= u.role === 'teacher' ? 'selected' : '' %>>Teacher</option>
                  <option value="ta" <%= u.role === 'ta' ? 'selected' : '' %>>Teaching assistant</option>
                </select>
                <button class="underline">Change role</button>
              </form>
              <form method="post" action="/admin/staff" onsubmit="return confirm('Reset password for <%= u.name %>?')">
                <input type="hidden" name="action" value="reset_password"><input type="hidden" name="user_id" value="<%= u.id %>">
                <button class="underline">Reset password</button>
              </form>
              <form method="post" action="/admin/staff">
                <input type="hidden" name="action" value="<%= u.status === 'active' ? 'suspend' : 'reactivate' %>"><input type="hidden" name="user_id" value="<%= u.id %>">
                <button class="underline"><%= u.status === 'active' ? 'Suspend' : 'Reactivate' %></button>
              </form>
            </div>
          <% } %>
        </div>
        <% if (u.role !== 'admin') { %>
          <div class="mt-3">
            <p class="text-xs font-semibold text-gray-500 mb-1">Assigned courses:</p>
            <div class="flex flex-wrap gap-2">
              <% (byUser[u.id] || []).forEach(a => { %>
                <span class="inline-flex items-center gap-1 text-xs bg-gray-100 dark:bg-gray-700 rounded-full px-3 py-1">
                  <%= a.title %>
                  <form method="post" action="/admin/staff" class="inline">
                    <input type="hidden" name="action" value="unassign">
                    <input type="hidden" name="user_id" value="<%= u.id %>"><input type="hidden" name="course_id" value="<%= a.course_id %>">
                    <button class="text-red-600 font-bold" title="Unassign" aria-label="Unassign <%= a.title %>">×</button>
                  </form>
                </span>
              <% }) %>
              <% if (!(byUser[u.id] || []).length) { %><span class="text-xs text-gray-400">None yet</span><% } %>
            </div>
            <form method="post" action="/admin/staff" class="mt-2 flex gap-2 text-xs">
              <input type="hidden" name="action" value="assign"><input type="hidden" name="user_id" value="<%= u.id %>">
              <select name="course_id" class="border rounded-lg px-2 py-1 bg-white dark:bg-gray-900">
                <% courses.forEach(c => { %><option value="<%= c.id %>"><%= c.title %></option><% }) %>
              </select>
              <button class="bg-navy text-white px-3 py-1 rounded-lg font-semibold">Assign</button>
            </form>
          </div>
        <% } %>
      </div>
    <% }) %>
  </section>
</div>

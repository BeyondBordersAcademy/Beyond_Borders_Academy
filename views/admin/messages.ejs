<%- include('_nav', { active: '/admin/messages' }) %>
<h1 class="text-3xl font-extrabold text-navy dark:text-white">Messages</h1>
<div class="gold-underline w-16 mt-2 mb-6"></div>
<div class="grid md:grid-cols-3 gap-6">
  <aside class="bg-white dark:bg-gray-800 rounded-xl shadow p-4">
    <h2 class="font-bold text-sm mb-2">Conversations</h2>
    <ul class="space-y-1 text-sm">
      <% convos.forEach(c => { %>
        <li><a href="/admin/messages?with=<%= c.id %>" class="flex justify-between gap-2 px-2 py-1.5 rounded <%= withId === c.id ? 'bg-gold/20 font-semibold' : 'hover:bg-gray-100 dark:hover:bg-gray-700' %>">
          <span><%= c.name %></span><% if (c.unread) { %><span class="bg-red-600 text-white text-xs rounded-full px-1.5"><%= c.unread %></span><% } %>
        </a></li>
      <% }) %>
      <% if (!convos.length) { %><li class="text-xs text-gray-500">No conversations yet.</li><% } %>
    </ul>
    <h2 class="font-bold text-sm mt-4 mb-2">Start new</h2>
    <form method="get" action="/admin/messages" class="flex gap-1 text-sm">
      <select name="with" class="flex-1 border rounded-lg px-2 py-1.5 bg-white dark:bg-gray-900 text-xs">
        <% students.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
      </select>
      <button class="bg-navy text-white px-3 py-1.5 rounded text-xs">Open</button>
    </form>
  </aside>
  <section class="md:col-span-2 bg-white dark:bg-gray-800 rounded-xl shadow p-5">
    <% if (!withId) { %><p class="text-sm text-gray-500">Select a conversation.</p><% } else { %>
      <div class="space-y-3 max-h-96 overflow-y-auto mb-4">
        <% thread.forEach(m => { const mine = m.from_user_id === user.id; %>
          <div class="flex <%= mine ? 'justify-end' : 'justify-start' %>">
            <div class="max-w-[80%] rounded-xl px-3 py-2 text-sm <%= mine ? 'bg-navy text-white' : 'bg-gray-100 dark:bg-gray-700' %>">
              <p class="whitespace-pre-line"><%= m.body %></p>
              <p class="text-[11px] opacity-70 mt-1"><%= fmtDateTime(m.created_at) %></p>
            </div>
          </div>
        <% }) %>
        <% if (!thread.length) { %><p class="text-sm text-gray-500">No messages yet.</p><% } %>
      </div>
      <form method="post" action="/admin/messages" class="flex gap-2">
        <input type="hidden" name="to_user_id" value="<%= withId %>">
        <input name="body" required maxlength="5000" placeholder="Write a message…" class="flex-1 border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900 text-sm">
        <button class="bg-navy text-white px-5 py-2 rounded-lg text-sm">Send</button>
      </form>
    <% } %>
  </section>
</div>

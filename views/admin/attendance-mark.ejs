<%- include('_nav', { active: '/admin/sessions' }) %>
<h1 class="text-3xl font-extrabold text-navy dark:text-white">Mark Attendance</h1>
<div class="gold-underline w-16 mt-2 mb-2"></div>
<p class="text-sm text-gray-600 dark:text-gray-300 mb-6"><strong><%= s.title %></strong> · <%= s.course_title %> · <%= sessionDisplayTime(s) %></p>

<form method="post" action="/admin/sessions/<%= s.id %>/attendance" class="bg-white dark:bg-gray-800 rounded-2xl shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="text-left text-gray-500 border-b dark:border-gray-700">
      <th class="px-4 py-3">Student</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Note</th>
    </tr></thead>
    <tbody>
      <% if (!students.length) { %>
        <tr><td colspan="3" class="px-4 py-8 text-center text-gray-500">No enrolled students in this course.</td></tr>
      <% } %>
      <% students.forEach(st => { const m = byUser[st.id]; const cur = m ? m.status : 'present'; %>
        <tr class="border-b border-gray-100 dark:border-gray-700">
          <td class="px-4 py-3"><p class="font-semibold"><%= st.name %></p><p class="text-xs text-gray-500"><%= st.email %></p></td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Attendance for <%= st.name %>">
              <% [['present','✅ Present'],['late','⏰ Late'],['absent','❌ Absent'],['excused','📝 Excused']].forEach(([val, label]) => { %>
                <label class="inline-flex items-center gap-1 border rounded-full px-3 py-1 cursor-pointer text-xs <%= cur === val ? 'border-gold bg-gold/10 font-bold' : 'border-gray-300 dark:border-gray-600' %>">
                  <input type="radio" name="status_<%= st.id %>" value="<%= val %>" <%= cur === val ? 'checked' : '' %> class="accent-[#C6A34B]"> <%= label %>
                </label>
              <% }) %>
            </div>
          </td>
          <td class="px-4 py-3"><input name="note_<%= st.id %>" maxlength="500" value="<%= m ? (m.note || '') : '' %>" placeholder="optional note" class="w-full border rounded-lg px-2 py-1.5 text-xs bg-white dark:bg-gray-900"></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="p-4 flex gap-3 items-center">
    <button class="bg-gold text-navy font-bold px-6 py-2.5 rounded-lg">Save Attendance</button>
    <a href="/admin/sessions" class="text-sm underline">Back to sessions</a>
  </div>
</form>
<p class="text-xs text-gray-500 mt-4">Defaults to <strong>Present</strong> for unmarked students. Every save is audit-logged with who marked it.</p>

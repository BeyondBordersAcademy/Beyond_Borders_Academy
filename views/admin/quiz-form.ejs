<%- include('_nav', { active: '/admin/quizzes' }) %>
<nav class="text-xs text-gray-500 mb-4"><a href="/admin/quizzes" class="underline">Quizzes</a> › <%= quiz ? 'Edit' : 'New' %></nav>
<h1 class="text-2xl font-extrabold text-navy dark:text-white"><%= quiz ? 'Edit Quiz: ' + quiz.title : 'New Quiz' %></h1>
<div class="gold-underline w-16 mt-2 mb-6"></div>

<% if (!quiz) { %>
  <div class="max-w-2xl bg-white dark:bg-gray-800 rounded-2xl shadow p-6">
    <form method="post" action="/admin/quizzes" class="space-y-4 text-sm">
      <div><label class="block font-semibold mb-1">Course *</label>
        <select name="course_id" required class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
          <% courses.forEach(c => { %><option value="<%= c.id %>"><%= c.title %></option><% }) %>
        </select></div>
      <div><label class="block font-semibold mb-1">Title *</label>
        <input name="title" required maxlength="200" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
      <div><label class="block font-semibold mb-1">Instructions</label>
        <textarea name="instructions" rows="3" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></textarea></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="block font-semibold mb-1">Time limit (minutes)</label><input name="time_limit_min" type="number" min="1" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
        <div><label class="block font-semibold mb-1">Attempts allowed</label><input name="attempts_allowed" type="number" min="1" value="1" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
        <div><label class="block font-semibold mb-1">Passing score (%)</label><input name="passing_score" type="number" min="0" max="100" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
        <div><label class="block font-semibold mb-1">Category</label>
          <select name="category" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
            <% ['quizzes','exams','assignments','participation'].forEach(x => { %><option><%= x %></option><% }) %>
          </select></div>
      </div>
      <label class="flex items-center gap-2"><input type="checkbox" name="randomize" class="accent-[#C6A34B]"> Randomize question order</label>
      <button class="bg-gold text-navy font-bold px-6 py-2.5 rounded-lg">Create Quiz</button>
    </form>
  </div>
<% } else { %>
  <div class="grid lg:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow p-6">
      <h2 class="font-bold text-navy dark:text-white mb-3">Quiz settings</h2>
      <form method="post" action="/admin/quizzes/<%= quiz.id %>" class="space-y-3 text-sm">
        <input type="hidden" name="action" value="update">
        <div><label class="block font-semibold mb-1">Title</label><input name="title" value="<%= quiz.title %>" maxlength="200" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
        <div><label class="block font-semibold mb-1">Instructions</label><textarea name="instructions" rows="2" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"><%= quiz.instructions %></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block font-semibold mb-1">Time limit (min)</label><input name="time_limit_min" type="number" min="1" value="<%= quiz.time_limit_min || '' %>" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div><label class="block font-semibold mb-1">Attempts</label><input name="attempts_allowed" type="number" min="1" value="<%= quiz.attempts_allowed %>" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div><label class="block font-semibold mb-1">Passing %</label><input name="passing_score" type="number" min="0" max="100" value="<%= quiz.passing_score || '' %>" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div><label class="block font-semibold mb-1">Weight</label><input name="weight" type="number" min="0" step="0.1" value="<%= quiz.weight || '' %>" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div><label class="block font-semibold mb-1">Available from</label><input name="available_from" type="datetime-local" value="<%= quiz.available_from ? quiz.available_from.slice(0,16) : '' %>" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div><label class="block font-semibold mb-1">Available until</label><input name="available_until" type="datetime-local" value="<%= quiz.available_until ? quiz.available_until.slice(0,16) : '' %>" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div><label class="block font-semibold mb-1">Due</label><input name="due_at" type="datetime-local" value="<%= quiz.due_at ? quiz.due_at.slice(0,16) : '' %>" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div><label class="block font-semibold mb-1">Category</label>
            <select name="category" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
              <% ['quizzes','exams','assignments','participation'].forEach(x => { %><option <%= quiz.category === x ? 'selected' : '' %>><%= x %></option><% }) %>
            </select></div>
        </div>
        <label class="flex items-center gap-2"><input type="checkbox" name="randomize" <%= quiz.randomize ? 'checked' : '' %> class="accent-[#C6A34B]"> Randomize question order</label>
        <button class="bg-navy text-white px-5 py-2 rounded-lg">Save Settings</button>
      </form>
      <div class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-4 space-y-2 text-sm">
        <form method="post" action="/admin/quizzes/<%= quiz.id %>" class="flex gap-2">
          <input type="hidden" name="action" value="copy_to_course">
          <select name="target_course_id" class="flex-1 border rounded-lg px-2 py-1.5 bg-white dark:bg-gray-900 text-sm">
            <% courses.forEach(c => { %><option value="<%= c.id %>"><%= c.title %></option><% }) %>
          </select>
          <button class="border border-gray-300 dark:border-gray-600 px-3 py-1.5 rounded text-xs">Copy quiz to course</button>
        </form>
        <form method="post" action="/admin/quizzes/<%= quiz.id %>" onsubmit="return confirm('Delete this quiz and all its questions/attempts?')">
          <input type="hidden" name="action" value="delete"><button class="text-red-600 text-xs underline">Delete quiz</button>
        </form>
      </div>
    </div>

    <div>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow p-6 mb-4">
        <h2 class="font-bold text-navy dark:text-white mb-3">Add question</h2>
        <form method="post" action="/admin/quizzes/<%= quiz.id %>" class="space-y-3 text-sm">
          <input type="hidden" name="action" value="add_question">
          <div><label class="block font-semibold mb-1">Type</label>
            <select name="qtype" id="qtype" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
              <option value="multiple_choice">Multiple choice (auto-graded)</option>
              <option value="multiple_select">Multiple selection (auto-graded)</option>
              <option value="true_false">True / False (auto-graded)</option>
              <option value="fill_blank">Fill in the blank (auto-graded)</option>
              <option value="short_answer">Short answer (manual grading)</option>
              <option value="essay">Essay (manual grading)</option>
            </select></div>
          <div><label class="block font-semibold mb-1">Prompt *</label>
            <textarea name="prompt" required rows="2" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></textarea></div>
          <div id="optsWrap"><label class="block font-semibold mb-1">Options (one per line)</label>
            <textarea name="options" rows="3" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900" placeholder="Option A&#10;Option B&#10;Option C"></textarea></div>
          <div id="correctSingleWrap"><label class="block font-semibold mb-1">Correct answer (exactly as written above)</label>
            <input name="correct_single" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div id="correctMultiWrap" class="hidden"><label class="block font-semibold mb-1">Correct answers (comma-separated, exactly as written)</label>
            <input name="correct_multi" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
          <div id="correctTextWrap" class="hidden"><label class="block font-semibold mb-1">Accepted answers (separate alternatives with | )</label>
            <input name="correct_text" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900" placeholder="am | 'm"></div>
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block font-semibold mb-1">Points</label><input name="points" type="number" min="0.5" step="0.5" value="1" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900"></div>
            <div><label class="block font-semibold mb-1">Question bank</label>
              <select name="bank_id" class="w-full border rounded-lg px-3 py-2 bg-white dark:bg-gray-900">
                <option value="">None</option><% banks.forEach(b => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
              </select></div>
          </div>
          <button class="bg-gold text-navy font-bold px-5 py-2 rounded-lg">Add Question</button>
        </form>
      </div>

      <h2 class="font-bold text-navy dark:text-white mb-2">Questions (<%= questions.length %>)</h2>
      <div class="space-y-2">
        <% questions.forEach((q, i) => { const opts = JSON.parse(q.options_json || '[]'); const corr = JSON.parse(q.correct_json); %>
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow px-4 py-3 text-sm">
            <div class="flex justify-between gap-2">
              <p class="font-semibold"><%= i + 1 %>. <%= q.prompt %></p>
              <form method="post" action="/admin/quizzes/<%= quiz.id %>" onsubmit="return confirm('Delete this question?')">
                <input type="hidden" name="action" value="delete_question"><input type="hidden" name="question_id" value="<%= q.id %>">
                <button class="text-red-600 text-xs">Delete</button>
              </form>
            </div>
            <p class="text-xs text-gray-500 mt-1"><%= q.qtype.replace(/_/g, ' ') %> · <%= q.points %> pt<% if (q.bank_id) { %> · bank #<%= q.bank_id %><% } %></p>
            <% if (opts.length) { %><p class="text-xs mt-1 text-gray-600 dark:text-gray-300">Options: <%= opts.join(' | ') %></p><% } %>
            <% if (corr != null) { %><p class="text-xs mt-1 text-green-700 dark:text-green-300">Answer key: <%= Array.isArray(corr) ? corr.join(' | ') : corr %></p><% } %>
          </div>
        <% }) %>
        <% if (!questions.length) { %><p class="text-sm text-gray-500">No questions yet — add the first one above.</p><% } %>
      </div>
    </div>
  </div>
<script>
(function () {
  const t = document.getElementById('qtype');
  const show = id => document.getElementById(id).classList.remove('hidden');
  const hide = id => document.getElementById(id).classList.add('hidden');
  function sync() {
    ['optsWrap','correctSingleWrap','correctMultiWrap','correctTextWrap'].forEach(hide);
    const v = t.value;
    if (v === 'multiple_choice' || v === 'true_false') { show('optsWrap'); show('correctSingleWrap'); }
    else if (v === 'multiple_select') { show('optsWrap'); show('correctMultiWrap'); }
    else if (v === 'fill_blank') { show('correctTextWrap'); }
  }
  t.addEventListener('change', sync); sync();
})();
</script>
<% } %>
